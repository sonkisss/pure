# 环境配置示例（不要提交真实密钥）
# 将本文件复制为 .env / .env.local 等，再填入真实值

# 应用配置
VITE_PORT=8848
VITE_PUBLIC_PATH=/
VITE_ROUTER_HISTORY=hash
VITE_CDN=false
VITE_COMPRESSION=none

# Supabase 配置
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_or_publishable_key
# 若需服务端能力才填，前端请勿使用真实 service_role
VITE_SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
VITE_SUPABASE_ACCESS_TOKEN=your_supabase_access_token_optional

# OSS 配置
VITE_OSS_REGION=oss-cn-your-region
VITE_OSS_ACCESS_KEY_ID=your_oss_access_key_id
VITE_OSS_ACCESS_KEY_SECRET=your_oss_access_key_secret
VITE_OSS_BUCKET=your-oss-bucket
VITE_OSS_ENDPOINT=https://oss-cn-your-region.aliyuncs.com

# 数据库（如有后端部署）
VITE_DB_HOST=your-db-host
VITE_DB_PORT=5432
VITE_DB_NAME=your-db-name
VITE_DB_USER=your-db-user
VITE_DB_PASSWORD=your-db-password
VITE_DB_SSL=false
VITE_DB_CONNECTION_TIMEOUT=30000
VITE_DB_POOL_MAX=10
VITE_DB_IDLE_TIMEOUT=30000

# JWT 配置（示例值，生产请使用安全随机串）
VITE_JWT_SECRET=replace_with_secure_random_secret
VITE_JWT_EXPIRES_IN=24h
