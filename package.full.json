{
  "name": "pure-admin-thin",
  "version": "5.5.0",
  "private": true,
  "type": "module",
  "description": "A clean, elegant, beautiful and powerful admin template, based on Vue3,Vite3,TypeScript,Ant Design.",
  "author": {
    "name": "chengyang",
    "email": "991098984@qq.com"
  },
  "scripts": {
    "dev": "vite --host --open",
    "serve": "vite --host --open",
    "build": "rimraf dist && vite build",
    "build:staging": "rimraf dist && vite build --mode staging",
    "report": "rimraf dist && vite build",
    "preview": "vite preview",
    "preview:build": "pnpm build && vite preview",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit --skipLibCheck",
    "svgo": "svgo -f . -r",
    "clean:cache": "rimraf .eslintcache && rimraf pnpm-lock.yaml && rimraf node_modules && pnpm store prune && pnpm install",
    "lint:eslint": "eslint --cache --max-warnings 0  \"{src,build}/**/*.{vue,js,ts,tsx}\" --fix",
    "lint:prettier": "prettier --write  \"src/**/*.{js,ts,json,tsx,css,scss,vue,html,md}\"",
    "lint:stylelint": "stylelint --cache --fix \"**/*.{html,vue,css,scss}\" --cache-location node_modules/.cache/stylelint/",
    "lint": "pnpm lint:eslint && pnpm lint:prettier && pnpm lint:stylelint",
    "prepare": "husky",
    "preinstall": "npx only-allow pnpm",
    "rules": "bash scripts/show-rules.sh",
    "changelog": "cat CHANGELOG.md | less",
    "docs:check": "bash scripts/check-docs.sh",
    "docs:archive": "bash scripts/archive-old-docs.sh"
  },
  "dependencies": {
    "@pureadmin/utils": "^2.4.8",
    "@vueuse/core": "^11.2.0",
    "@vueuse/shared": "^11.2.0",
    "animate.css": "^4.1.1",
    "axios": "^1.12.2",
    "bcryptjs": "^3.0.3",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.18",
    "echarts": "^6.0.0",
    "element-plus": "^2.8.8",
    "jwt-decode": "^4.0.0",
    "jsonwebtoken": "^9.0.3",
    "lodash-es": "^4.17.21",
    "pinia": "^3.0.3",
    "pinia-plugin-persistedstate": "^4.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remixicon": "^4.5.0",
    "sortablejs": "^1.15.6",
    "vfonts": "^0.1.0",
    "vue": "^3.5.13",
    "vue-demi": "^0.14.10",
    "vue-i18n": "^10.0.5",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.26.3",
    "@babel/preset-typescript": "^7.26.0",
    "@eslint/js": "^9.17.0",
    "@iconify/json": "^2.2.290",
    "@iconify/vue": "^4.3.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/crypto-js": "^4.2.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/jwt-decode": "^3.1.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.10.2",
    "@types/sortablejs": "^1.15.8",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitejs/plugin-vue-jsx": "^4.1.1",
    "@vue/compiler-sfc": "^3.5.13",
    "autoprefixer": "^10.4.20",
    "boxicons": "^2.1.4",
    "consola": "^3.3.2",
    "core-js": "^3.39.0",
    "css-declaration-sorter": "^7.2.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "eslint-plugin-vue": "^9.32.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "postcss": "^8.5.1",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "rollup-plugin-visualizer": "^5.12.0",
    "sass": "^1.83.1",
    "stylelint": "^16.12.0",
    "stylelint-config-standard": "^36.0.1",
    "stylelint-config-standard-scss": "^14.0.0",
    "stylelint-order": "^6.0.4",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.7.2",
    "unplugin-auto-import": "^0.18.0",
    "unplugin-icons": "^0.21.4",
    "unplugin-vue-components": "^27.4.4",
    "vite": "^7.1.12",
    "vite-plugin-chrome-extension": "^0.0.7",
    "vite-plugin-compression2": "^1.3.2",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-remove-console": "^2.2.0",
    "vite-plugin-vitepress-auto-sidebar": "^1.11.3",
    "vue-tsc": "^2.1.10"
  },
  "engines": {
    "node": "^20.19.0 || >=22.13.0",
    "pnpm": ">=9"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": ["@babel/core", "@babel/preset-env", "@babel/preset-react", "@babel/preset-typescript"]
    }
  },
  "repository": {
    "url": "https://github.com/sx-code/pure-admin-thin"
  },
  "homepage": "https://yiming_chang.gitee.io/pure-admin-thin",
  "bugs": {
    "url": "https://github.com/pure-admin/pure-admin-thin/issues"
  },
  "keywords": [
    "pure-admin-thin",
    "vue-pure-admin",
    "element-plus",
    "tailwindcss",
    "pure-admin",
    "typescript",
    "pinia",
    "vue3",
    "vite",
    "esm"
  ],
  "license": "MIT",
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --cache --max-warnings 0 --fix"
    ],
    "{!(package)*.json,*.code-snippets,.!({browserslist,npm,nvm})*rc}": [
      "prettier --cache --write"
    ],
    "*.vue": [
      "eslint --cache --max-warnings 0 --fix",
      "prettier --cache --write"
    ],
    "*.{css,scss,html}": [
      "stylelint --cache --fix",
      "prettier --cache --write"
    ],
    "*.md": [
      "prettier --cache --write"
    ]
  }
}